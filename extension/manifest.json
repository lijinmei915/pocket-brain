{
  "manifest_version": 3,
  "name": "Pocket Brain",
  "version": "1.0",
  "description": "一键保存当前页面到 Pocket Brain",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-192.png",
      "48": "icon-192.png",
      "128": "icon-512.png"
    }
  },
  "icons": {
    "16": "icon-192.png",
    "48": "icon-192.png",
    "128": "icon-512.png"
  },
  "permissions": ["activeTab", "windows", "storage"],
  "host_permissions": [
    "https://clujgrcidguwgufqekve.supabase.co/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "http://localhost:5173/*",
    "http://127.0.0.1:5173/*",
    "https://pocket-brain-blush.vercel.app/*"
  ]
}
