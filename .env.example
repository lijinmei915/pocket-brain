# Supabase 配置
# 复制此文件为 .env.local，填入真实值（.env.local 不会提交到 git）

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_KEY=your-anon-public-key
QWEN_API_KEY=your-qwen-api-key
